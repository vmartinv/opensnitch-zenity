[Unit]
Description=OpenSnitch prompt UI (zenity)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
# opensnitchd (root) connects to the socket in the real /tmp, so this unit
# must not use PrivateTmp.
ExecStart=/usr/bin/opensnitch-zenity
Restart=on-failure
RestartSec=2
NoNewPrivileges=true

[Install]
WantedBy=graphical-session.target
